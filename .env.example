# Copy to .env.local. Never commit real secrets. The anon key is public by design;
# NEVER put a service_role key in any VITE_* variable.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Canonical origin once the domain is bought, no trailing slash. Enables sitemap.xml + canonical/OG URLs.
VITE_SITE_URL=
# Optional absolute/relative OG share image.
VITE_OG_IMAGE=
# demo = local-only fake backend (NO real security). Leave empty in production.
VITE_DATA_MODE=
